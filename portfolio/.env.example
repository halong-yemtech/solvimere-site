# ─────────────────────────────────────────────────────────────
# Portfolio environment variables — copy to .env and fill in.
# ─────────────────────────────────────────────────────────────

# ── Payload CMS (required in production) ─────────────────────
# Signs admin login sessions. Any long random string, e.g.
#   openssl rand -hex 32
PAYLOAD_SECRET=

# ── Supabase (where ALL portfolio content is stored) ────────
# Database: Supabase → Connect → "Session pooler" URI (port 5432), with your DB password.
# Payload keeps its tables in the `payload` schema (not exposed to the public API).
# Without a postgres:// URI the old local SQLite file (./portfolio.db) is used instead.
DATABASE_URI=

# Media (images, CV PDFs): Supabase Storage via its S3 protocol.
# Storage → Settings → S3 Connection: endpoint + region; "New access key" for the keys.
# Create a bucket named "portfolio" (private is fine: files are served through /team/api/media).
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_REGION=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_S3_BUCKET=portfolio

# ── Email (Resend) ───────────────────────────────────────────
# Password reset + inbox notifications. Empty = emails are logged to the console.
# resend.com → API Keys. The sender domain must be verified in Resend
# (onboarding@resend.dev only delivers to your own Resend account email).
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=

# ── Google Analytics 4 (tracking tag) ────────────────────────
# GA4 → Admin → Data streams → your web stream → Measurement ID (G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# ── Google Analytics Data API (page-view card on the Stats page) ──
# Server-only. GA4 → Admin → Property settings → Property ID (numbers only)
GA_PROPERTY_ID=
# Google Cloud service account with "Google Analytics Data API" enabled,
# added as a Viewer on the GA4 property. Copy from its JSON key file.
GA_CLIENT_EMAIL=
# Keep the quotes and the literal \n sequences.
GA_PRIVATE_KEY=

# Optional: GitHub token for the live contribution graph on blog posts (uses the
# official API; without it the public profile calendar is read instead).
# GITHUB_TOKEN=
